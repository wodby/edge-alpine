#!/command/with-contenv sh

# Confd can request a reload as soon as its initial template is written. Start
# watching only after nginx is able to receive that signal.
until pidof nginx >/dev/null; do
    sleep 1
done

# The lego reload waits up to EXEC_PROPAGATION_TIMEOUT for DNS-01 records, longer
# than confd's default 60-second reload limit; 0 turns that limit off.
exec /opt/wodby/tools/bin/confd etcd \
    --node "http://${WODBY_ETCD_HOST:-etcd.wodby}:${WODBY_ETCD_PORT:-2379}" \
    --watch \
    --reload-cmd-timeout=0
