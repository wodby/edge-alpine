user="wodby"
srv="${WODBY_HOME:-/srv}"
wodby_home="${srv}"
state_uuid="0"
repo="${srv}/.repo"
docroot="${WODBY_APP_DOCROOT:-}"
lockdir="${srv}/.wodby/locks"
etcd_ip="${WODBY_ETCD_HOST:-etcd.wodby}"
etcd_port="${WODBY_ETCD_PORT:-2379}"
etcd="http://${etcd_ip}:${etcd_port}"
backend_host="wodby-svc.wodby"
backend_port="8125"
backend_prefix="http://"

if [ -n "${backend_host}" ] && [ -n "${backend_port}" ]; then
  backend="${backend_prefix}${backend_host}:${backend_port}"
  is_backend=0
else
  backend="${etcd}"
  is_backend=1
fi

response_path="wodby/states/result"
: "${WODBY_APP_TYPE:=drupal}"
: "${WODBY_APP_VERSION:=7}"
