#!/bin/sh

. "/etc/wodby/config"
. "/etc/wodby/functions"
. "/etc/wodby/lego"

action_key="wodby/states/execute/edge/lego"
remove_key "${action_key}"
log

edge_dir="/mnt/containers/edge"

if [ "${challenge:-http}" = "dns" ]; then
    : "${domain:?technical certificate domain is required}"
    : "${dns_callback_url:?ACME DNS callback URL is required}"
    : "${dns_callback_token:?ACME DNS callback token is required}"
    export dns_callback_url dns_callback_token

    # lego 5 `run` obtains a missing certificate and otherwise renews it when it
    # is due or when its domains differ. `run` forces a new certificate, as it
    # always did with lego 4.
    case "${action}" in
        ensure|renew)
            set -- --renew-days=45 --no-random-sleep --force-cert-domains
            ;;
        run)
            set -- --renew-force --no-random-sleep --force-cert-domains
            ;;
        *)
            result="unsupported DNS lego action: ${action}"
            errno=2
            answer
            ;;
    esac

    # Like lego 4, wait only for the authoritative name servers; lego 5 also
    # waits for public resolvers, which may still cache the missing record.
    result=$(EXEC_PATH=/opt/bin/lego-dns-callback \
        EXEC_PROPAGATION_TIMEOUT=180 \
        EXEC_POLLING_INTERVAL=4 \
        EXEC_SEQUENCE_INTERVAL=2 \
        "$WODBY_BIN/lego" run -a \
        --email="${email}" \
        --domains="${domain}" \
        --domains="*.${domain}" \
        --dns=exec \
        --dns.propagation.disable-rns \
        --path="${edge_dir}" \
        "$@" 2>&1)
else
    if [ "${action}" != "revoke" ] \
        && [ ! -f "${edge_dir}/accounts/acme-v02.api.letsencrypt.org/hello@wodby.com/account.json" ]; then
        action="run"
    fi

    case "${action}" in
        run)
            set -- run -a --renew-force --no-random-sleep --force-cert-domains
            ;;
        renew)
            set -- run -a --renew-days=45 --no-random-sleep
            ;;
        revoke)
            # lego 5 names a certificate by its first domain and archives it
            # after revoking, as lego 4 did.
            set -- certificates revoke --cert.name="${domains%%,*}"
            ;;
        *)
            result="unsupported lego action: ${action}"
            errno=2
            answer
            ;;
    esac

    if [ "${action}" = "revoke" ]; then
        result=$("$WODBY_BIN/lego" "$@" \
            --email="${email}" \
            --path="${edge_dir}" 2>&1)
    else
        result=$("$WODBY_BIN/lego" "$@" \
            --email="${email}" \
            --domains="${domains}" \
            --http \
            --http.webroot="${edge_dir}" \
            --path="${edge_dir}" 2>&1)
    fi
fi

errno=$?
answer
