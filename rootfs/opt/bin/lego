#!/bin/sh

. "/etc/wodby/config"
. "/etc/wodby/functions"
. "/etc/wodby/lego"

action_key="wodby/states/execute/edge/lego"
remove_key "${action_key}"
log

edge_dir="/mnt/containers/edge"

if [ ! -f "${edge_dir}/accounts/acme-v02.api.letsencrypt.org/hello@wodby.com/account.json" ]; then
    action="run"
fi

case "${action}" in
    run)
        set -- run
        ;;
    renew)
        set -- renew --days=45
        ;;
    *)
        result="unsupported lego action: ${action}"
        errno=2
        answer
        ;;
esac

result=$("$WODBY_BIN/lego" -a \
    --email="${email}" \
    --domains="${domains}" \
    --http \
    --http.webroot="${edge_dir}" \
    --path="${edge_dir}" \
    "$@" 2>&1)

errno=$?
answer
